# ==========================================
# SentriCore - Comprehensive .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
*/.env
*.env

# Production Builds
dist/
dist-ssr/
build/
client/dist/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Temporary & Backup Dumps
backups/
backup-*/
*-backup-*/
*.bak
*.tmp
